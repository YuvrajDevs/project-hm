# Copy to .env (never committed). EXPO_PUBLIC_* values are compiled into the app.
# OAuth "Web client" ID from the Firebase project's Google sign-in provider (needed for native Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Where legal pages, invite links and the chat-reset endpoint live
EXPO_PUBLIC_SITE_URL=https://honestmailbox.com
# Local development only
EXPO_PUBLIC_USE_EMULATORS=0
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
