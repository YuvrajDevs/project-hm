rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Membership is decided by the couple document, never by a field a user can set on their own profile
    function isMember(coupleData) {
      return isAuthenticated()
        && (request.auth.uid == coupleData.partnerA_uid || request.auth.uid == coupleData.partnerB_uid);
    }

    function isPartOfCouple(coupleId) {
      return isMember(get(/databases/$(database)/documents/couples/$(coupleId)).data);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Safe couple item deletion: allows deletion if the caller created it, OR if an approved mutual reset
    // is in progress (accepted by the other partner), OR if the couple is actively unpairing.
    function canDeleteCoupleItem(coupleId, authorUid) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      return isMember(couple) && (
        request.auth.uid == authorUid
        || (couple.get('resetStatus', null) == 'pending' && couple.get('resetBy', null) != request.auth.uid)
        || couple.get('unpairingBy', null) == request.auth.uid
      );
    }

    // ─── User profiles ───────────────────────────────────────────────────────
    match /users/{userId} {
      // Your own profile, or the profile of the person currently paired with you
      allow read: if isOwner(userId)
        || (isAuthenticated() && resource.data.get('partnerId', null) == request.auth.uid);

      allow create: if isOwner(userId)
        && request.resource.data.get('coupleId', null) == null
        && request.resource.data.get('partnerId', null) == null
        && request.resource.data.get('role', null) == null;

      allow delete: if isOwner(userId);

      // Your own profile, except the pairing fields (see below)
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coupleId', 'partnerId', 'role'])
        || isLinkChange(userId)
      );

      // The other person may only touch the pairing fields, and only to link or unlink
      allow update: if isAuthenticated() && request.auth.uid != userId
        && changedOnly(['coupleId', 'partnerId', 'role', 'leftByPartner'])
        && isLinkChange(userId);

      // Linking: both people must be named on the couple document written in the same transaction,
      // and this profile must not already be paired.
      // Unlinking: only someone currently paired with this profile (or the owner) can clear the link.
      function isLinkChange(userId) {
        let before = resource.data;
        let after = request.resource.data;
        return (
          after.get('coupleId', null) != null
          && before.get('coupleId', null) == null
          && isMember(getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data)
          && userId in [
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerA_uid,
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerB_uid
          ]
          && after.partnerId != userId
          && after.partnerId in [
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerA_uid,
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerB_uid
          ]
        ) || (
          after.get('coupleId', null) == null
          && after.get('partnerId', null) == null
          && after.get('role', null) == null
          && (request.auth.uid == userId || before.get('partnerId', null) == request.auth.uid)
        );
      }

      // Notes about the partner: private by default; the writer can share one, and then the partner can read it
      match /notes/{noteId} {
        allow read: if isOwner(userId)
          || (isAuthenticated()
            && resource.data.get('shared', false) == true
            && get(/databases/$(database)/documents/users/$(userId)).data.get('partnerId', null) == request.auth.uid);
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 280
          && (!('shared' in request.resource.data) || request.resource.data.shared is bool);
      }

      // In-app notifications: written by the partner, read and cleared by the owner
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated()
          && request.resource.data.uid == userId
          && request.resource.data.read == false
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && request.resource.data.body is string && request.resource.data.body.size() <= 300
          && get(/databases/$(database)/documents/users/$(userId)).data.get('partnerId', null) == request.auth.uid;
      }

      // Chat key backup: the owner only, never the partner. `chatPublicKey` itself is a field on
      // this document (readable by the partner via the rule above, writable by the owner) since the
      // partner needs it to derive the shared chat key - only the wrapped PRIVATE key backup lives here.
      match /keys/{keyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Invites ─────────────────────────────────────────────────────────────
    // A code can be looked up by anyone who has it, but codes can never be listed.
    match /invites/{inviteId} {
      allow get: if isAuthenticated();
      allow list: if false;

      // Codes are 6 (older) or 8 letters and digits, live at most four days, and carry nothing else
      allow create: if isAuthenticated()
        && inviteId.matches('^[A-Z2-9]{6,8}$')
        && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt', 'used'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(4, 'd');

      // One use, by someone other than the creator, before it expires
      allow update: if isAuthenticated()
        && resource.data.used == false
        && resource.data.createdBy != request.auth.uid
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && changedOnly(['used', 'usedBy'])
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time);

      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ─── Couples ─────────────────────────────────────────────────────────────
    match /couples/{coupleId} {
      allow read, delete: if isMember(resource.data);

      // Created by the person accepting an invite, together with that invite being consumed
      allow create: if isAuthenticated()
        && request.resource.data.partnerB_uid == request.auth.uid
        && request.resource.data.partnerA_uid != request.auth.uid
        && request.resource.data.partnerA_uid is string
        && isConsumingInvite(request.resource.data.inviteCode, request.resource.data.partnerA_uid);

      // The invite must be unused, belong to the other partner, and be claimed by the caller in this same transaction
      function isConsumingInvite(code, creatorUid) {
        let before = get(/databases/$(database)/documents/invites/$(code)).data;
        let after = getAfter(/databases/$(database)/documents/invites/$(code)).data;
        return before.used == false
          && before.createdBy == creatorUid
          && after.used == true
          && after.usedBy == request.auth.uid;
      }

      // Members can change settings, never who the members are.
      // State machine validation prevents UI lockout and flag/reset spoofing.
      allow update: if isMember(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerA_uid', 'partnerB_uid', 'id', 'inviteCode'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['whiteFlagBy'])
            || request.resource.data.whiteFlagBy == null
            || request.resource.data.whiteFlagBy == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resetStatus'])
            || request.resource.data.resetStatus == null
            || request.resource.data.resetStatus in ['pending', 'declined'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resetBy'])
            || request.resource.data.resetBy == null
            || request.resource.data.resetBy == request.auth.uid
            || (resource.data.get('resetStatus', null) == 'pending' && request.resource.data.resetStatus == null))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unpairingBy'])
            || request.resource.data.unpairingBy == null
            || request.resource.data.unpairingBy == request.auth.uid);

      match /mailbox/{messageId} {
        allow read: if isPartOfCouple(coupleId);
        allow create: if isPartOfCouple(coupleId)
          && request.resource.data.senderUid == request.auth.uid
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140));

        // The sender edits their own words (only until the note is answered).
        // The receiver can only respond and mark as read.
        // Either one can hide it for themselves (restricted to adding own uid).
        // Opening an unlocked time capsule is verified against capsule doc.
        allow update: if isPartOfCouple(coupleId) && (
          (resource.data.senderUid == request.auth.uid
            && !('response' in resource.data)
            && changedOnly(['status', 'intent', 'note', 'updatedAt'])
            && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140)))
          || (resource.data.senderUid != request.auth.uid
            && changedOnly(['response', 'readAt']))
          || (changedOnly(['hiddenFor'])
            && request.resource.data.hiddenFor is list
            && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor', []))
            && request.resource.data.hiddenFor.toSet().difference(resource.data.get('hiddenFor', []).toSet()).hasOnly([request.auth.uid]))
          // Either one can save it for themselves (and un-save it), touching only their own uid
          || (changedOnly(['savedBy'])
            && request.resource.data.savedBy is list
            && request.resource.data.savedBy.toSet().difference(resource.data.get('savedBy', []).toSet()).hasOnly([request.auth.uid])
            && resource.data.get('savedBy', []).toSet().difference(request.resource.data.savedBy.toSet()).hasOnly([request.auth.uid]))
          || (resource.data.get('sealed', false) == true
            && request.resource.data.sealed == false
            && changedOnly(['status', 'intent', 'note', 'sealed'])
            && isOpeningCapsule(messageId))
        );

        // An unlocked capsule is opened by copying its exact words into the note, nothing else
        function isOpeningCapsule(messageId) {
          let capsule = get(/databases/$(database)/documents/couples/$(coupleId)/capsules/$(messageId)).data;
          return capsule.unlockAtTs <= request.time
            && request.resource.data.status == capsule.status
            && request.resource.data.intent == capsule.intent
            && request.resource.data.note == capsule.note;
        }

        // Only the sender or an approved reset/unpair flow can delete notes
        allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.senderUid);
      }

      // Time capsule contents: only the sender can read them before the unlock time.
      // Receiver CANNOT delete a capsule before the unlock time.
      match /capsules/{messageId} {
        allow get: if isPartOfCouple(coupleId)
          && (resource.data.senderUid == request.auth.uid || resource.data.unlockAtTs <= request.time);
        allow list: if false;
        allow create: if isPartOfCouple(coupleId)
          && request.resource.data.senderUid == request.auth.uid
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
        allow update: if isPartOfCouple(coupleId)
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.unlockAtTs == resource.data.unlockAtTs
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
        allow delete: if isPartOfCouple(coupleId) && (
          resource.data.senderUid == request.auth.uid
          || resource.data.unlockAtTs <= request.time
          || canDeleteCoupleItem(coupleId, resource.data.senderUid)
        );
      }

      // Games in progress, shared by both partners (the app keeps at most a few of each kind open)
      match /games/{gameId} {
        allow read, create, update, delete: if isPartOfCouple(coupleId);
      }

      // Shared bucket list: either partner can add, tick off or remove items
      match /bucket_list/{itemId} {
        allow read: if isPartOfCouple(coupleId);
        allow create: if isPartOfCouple(coupleId)
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 120;
        allow update: if isPartOfCouple(coupleId)
          && changedOnly(['done', 'doneBy', 'doneAt'])
          && (request.resource.data.get('doneBy', null) == null || request.resource.data.doneBy == request.auth.uid);
        allow delete: if isPartOfCouple(coupleId);
      }

      // Chat: end-to-end encrypted. The content is opaque ciphertext (`ct`), so the server can only
      // check its size and shape, not per-kind rules like a mime whitelist or a voice-duration cap -
      // those are enforced client-side (lib/chatMedia.ts) before encryption.
      // Either person can save a message for themselves; only the sender can unsend it.
      match /chat/{messageId} {
        allow read: if isPartOfCouple(coupleId);
        allow create: if isPartOfCouple(coupleId)
          && request.resource.data.keys().hasOnly(['senderUid', 'kind', 'v', 'iv', 'ct', 'createdAt', 'once'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['text', 'image', 'voice', 'sticker', 'video']
          && (!('once' in request.resource.data) || request.resource.data.once == true)
          && request.resource.data.v == 1
          && request.resource.data.iv is string && request.resource.data.iv.size() == 16
          && request.resource.data.ct is string
          && request.resource.data.ct.size() > 0 && request.resource.data.ct.size() <= 900000;
        allow update: if isPartOfCouple(coupleId)
          && (
            (changedOnly(['savedBy'])
              && request.resource.data.savedBy is list
              && request.resource.data.savedBy.toSet().difference(resource.data.get('savedBy', []).toSet()).hasOnly([request.auth.uid])
              && resource.data.get('savedBy', []).toSet().difference(request.resource.data.savedBy.toSet()).hasOnly([request.auth.uid]))
            // View once: only the person it was sent TO can open it, once, and opening wipes the content
            || (resource.data.get('once', false) == true
              && resource.data.senderUid != request.auth.uid
              && !('openedAt' in resource.data)
              && changedOnly(['openedAt', 'ct'])
              && request.resource.data.openedAt == request.time
              && request.resource.data.ct is string && request.resource.data.ct.size() <= 4)
          );
        allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.senderUid);
      }

      // Chat wallpaper: one document per person, describing how their own chat looks. The picture is
      // ciphertext like any message. Either partner can read both (to offer a wallpaper to the other);
      // each person writes only their own.
      match /chat_wallpaper/{uid} {
        allow read: if isPartOfCouple(coupleId);
        allow create, update: if isPartOfCouple(coupleId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['source', 'dim', 'blur', 'iv', 'ct', 'updatedAt', 'dismissedOffer'])
          && request.resource.data.source in ['own', 'partner', 'none']
          && request.resource.data.dim is int && request.resource.data.dim >= 0 && request.resource.data.dim <= 4
          && request.resource.data.blur is int && request.resource.data.blur >= 0 && request.resource.data.blur <= 4
          && request.resource.data.updatedAt == request.time
          && (!('ct' in request.resource.data) || (request.resource.data.ct is string && request.resource.data.ct.size() <= 900000))
          && (!('iv' in request.resource.data) || (request.resource.data.iv is string && request.resource.data.iv.size() == 16))
          && (!('dismissedOffer' in request.resource.data) || request.resource.data.dismissedOffer is string);
        allow delete: if isPartOfCouple(coupleId) && uid == request.auth.uid;
      }

      // Finished games, kept so the two of them can look back at them
      match /game_history/{entryId} {
        allow read, create, delete: if isPartOfCouple(coupleId);
        allow update: if false;
      }

      match /checkins/{checkinId} {
        allow read: if isPartOfCouple(coupleId);
        allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.userUid);
        // One document per person per day, bounded ratings 1-10
        allow create, update: if isPartOfCouple(coupleId)
          && request.resource.data.userUid == request.auth.uid
          && checkinId == request.resource.data.dateId + '_' + request.auth.uid
          && request.resource.data.mood is number && request.resource.data.mood >= 1 && request.resource.data.mood <= 10
          && request.resource.data.connection is number && request.resource.data.connection >= 1 && request.resource.data.connection <= 10
          && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 280))
          && (!('joyReason' in request.resource.data) || (request.resource.data.joyReason is string && request.resource.data.joyReason.size() <= 280));
      }

      match /reactions/{reactionId} {
        allow read: if isPartOfCouple(coupleId);
        allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.senderUid);
        allow create, update: if isPartOfCouple(coupleId)
          && request.resource.data.senderUid == request.auth.uid
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 50));
      }

      match /events/{eventId} {
        allow read: if isPartOfCouple(coupleId);
        allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.createdBy);
        allow create: if isPartOfCouple(coupleId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
        allow update: if isPartOfCouple(coupleId)
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 100))
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      }

      match /safe_space_sessions/{sessionId} {
        allow read: if isPartOfCouple(coupleId);
        allow create, update: if isPartOfCouple(coupleId);
        allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.get('startedBy', request.auth.uid));

        match /messages/{messageId} {
          allow read: if isPartOfCouple(coupleId);
          allow delete: if isPartOfCouple(coupleId) && canDeleteCoupleItem(coupleId, resource.data.senderUid);
          allow create: if isPartOfCouple(coupleId)
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
        }
      }
    }

    // ─── Contact form ────────────────────────────────────────────────────────
    // Write-only from the app; read in the Firebase console
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'purpose', 'message', 'createdAt'])
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 100
        && request.resource.data.get('purpose', '') is string && request.resource.data.get('purpose', '').size() <= 50
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;
    }
  }
}
