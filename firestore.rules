rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Membership is decided by the couple document, never by a field a user can set on their own profile
    function isMember(coupleData) {
      return isAuthenticated()
        && (request.auth.uid == coupleData.partnerA_uid || request.auth.uid == coupleData.partnerB_uid);
    }

    function isPartOfCouple(coupleId) {
      return isMember(get(/databases/$(database)/documents/couples/$(coupleId)).data);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── User profiles ───────────────────────────────────────────────────────
    match /users/{userId} {
      // Your own profile, or the profile of the person currently paired with you
      allow read: if isOwner(userId)
        || (isAuthenticated() && resource.data.get('partnerId', null) == request.auth.uid);

      allow create, delete: if isOwner(userId);

      // Your own profile, except the pairing fields (see below)
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coupleId', 'partnerId', 'role'])
        || isLinkChange(userId)
      );

      // The other person may only touch the pairing fields, and only to link or unlink
      allow update: if isAuthenticated() && request.auth.uid != userId
        && changedOnly(['coupleId', 'partnerId', 'role', 'leftByPartner'])
        && isLinkChange(userId);

      // Linking: both people must be named on the couple document written in the same transaction,
      // and this profile must not already be paired.
      // Unlinking: only someone currently paired with this profile (or the owner) can clear the link.
      function isLinkChange(userId) {
        let before = resource.data;
        let after = request.resource.data;
        return (
          after.get('coupleId', null) != null
          && before.get('coupleId', null) == null
          && isMember(getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data)
          && userId in [
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerA_uid,
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerB_uid
          ]
          && after.partnerId != userId
          && after.partnerId in [
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerA_uid,
            getAfter(/databases/$(database)/documents/couples/$(after.coupleId)).data.partnerB_uid
          ]
        ) || (
          after.get('coupleId', null) == null
          && after.get('partnerId', null) == null
          && after.get('role', null) == null
          && (request.auth.uid == userId || before.get('partnerId', null) == request.auth.uid)
        );
      }

      // Private notes: never visible to the partner
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      // In-app notifications: written by the partner, read and cleared by the owner
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated()
          && request.resource.data.uid == userId
          && request.resource.data.read == false
          && get(/databases/$(database)/documents/users/$(userId)).data.get('partnerId', null) == request.auth.uid;
      }
    }

    // ─── Invites ─────────────────────────────────────────────────────────────
    // A code can be looked up by anyone who has it, but codes can never be listed.
    match /invites/{inviteId} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.used == false;

      // One use, by someone other than the creator, before it expires
      allow update: if isAuthenticated()
        && resource.data.used == false
        && resource.data.createdBy != request.auth.uid
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && changedOnly(['used', 'usedBy'])
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time);

      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ─── Couples ─────────────────────────────────────────────────────────────
    match /couples/{coupleId} {
      allow read, delete: if isMember(resource.data);

      // Created by the person accepting an invite, together with that invite being consumed
      allow create: if isAuthenticated()
        && request.resource.data.partnerB_uid == request.auth.uid
        && request.resource.data.partnerA_uid != request.auth.uid
        && request.resource.data.partnerA_uid is string
        && isConsumingInvite(request.resource.data.inviteCode, request.resource.data.partnerA_uid);

      // The invite must be unused, belong to the other partner, and be claimed by the caller in this same transaction
      function isConsumingInvite(code, creatorUid) {
        let before = get(/databases/$(database)/documents/invites/$(code)).data;
        let after = getAfter(/databases/$(database)/documents/invites/$(code)).data;
        return before.used == false
          && before.createdBy == creatorUid
          && after.used == true
          && after.usedBy == request.auth.uid;
      }

      // Members can change settings, never who the members are
      allow update: if isMember(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerA_uid', 'partnerB_uid', 'id', 'inviteCode']);

      match /mailbox/{messageId} {
        allow read: if isPartOfCouple(coupleId);
        allow create: if isPartOfCouple(coupleId) && request.resource.data.senderUid == request.auth.uid;

        // The sender edits their own words (only until the note is answered).
        // The receiver can only respond and mark as read.
        // Either one can hide it for themselves, or open an unlocked time capsule.
        allow update: if isPartOfCouple(coupleId) && (
          (resource.data.senderUid == request.auth.uid
            && !('response' in resource.data)
            && changedOnly(['status', 'intent', 'note', 'updatedAt']))
          || (resource.data.senderUid != request.auth.uid
            && changedOnly(['response', 'readAt']))
          || changedOnly(['hiddenFor'])
          || (resource.data.get('sealed', false) == true
            && request.resource.data.sealed == false
            && changedOnly(['status', 'intent', 'note', 'sealed'])
            && isOpeningCapsule(messageId))
        );

        // An unlocked capsule is opened by copying its exact words into the note, nothing else
        function isOpeningCapsule(messageId) {
          let capsule = get(/databases/$(database)/documents/couples/$(coupleId)/capsules/$(messageId)).data;
          return capsule.unlockAtTs <= request.time
            && request.resource.data.status == capsule.status
            && request.resource.data.intent == capsule.intent
            && request.resource.data.note == capsule.note;
        }

        // Either member can delete: reset and unpair remove the whole history
        allow delete: if isPartOfCouple(coupleId);
      }

      // Time capsule contents: only the sender can read them before the unlock time.
      // Never listable, so a partner cannot browse what is waiting for them.
      match /capsules/{messageId} {
        allow get: if isPartOfCouple(coupleId)
          && (resource.data.senderUid == request.auth.uid || resource.data.unlockAtTs <= request.time);
        allow list: if false;
        allow create: if isPartOfCouple(coupleId) && request.resource.data.senderUid == request.auth.uid;
        allow update: if isPartOfCouple(coupleId)
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.unlockAtTs == resource.data.unlockAtTs;
        allow delete: if isPartOfCouple(coupleId);
      }

      // One live game and one question deck at a time, shared by both partners
      match /games/{gameId} {
        allow read, delete: if isPartOfCouple(coupleId);
        allow create, update: if isPartOfCouple(coupleId) && gameId in ['current', 'questions'];
      }

      // Finished games, kept so the two of them can look back at them
      match /game_history/{entryId} {
        allow read, create, delete: if isPartOfCouple(coupleId);
        allow update: if false;
      }

      match /checkins/{checkinId} {
        allow read, delete: if isPartOfCouple(coupleId);
        // One document per person per day, and only that person can write it
        allow create, update: if isPartOfCouple(coupleId)
          && request.resource.data.userUid == request.auth.uid
          && checkinId == request.resource.data.dateId + '_' + request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow read, delete: if isPartOfCouple(coupleId);
        allow create, update: if isPartOfCouple(coupleId) && request.resource.data.senderUid == request.auth.uid;
      }

      match /events/{eventId} {
        allow read, delete: if isPartOfCouple(coupleId);
        allow create: if isPartOfCouple(coupleId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isPartOfCouple(coupleId);
      }

      match /safe_space_sessions/{sessionId} {
        allow read, write: if isPartOfCouple(coupleId);

        match /messages/{messageId} {
          allow read, delete: if isPartOfCouple(coupleId);
          allow create: if isPartOfCouple(coupleId) && request.resource.data.senderUid == request.auth.uid;
        }
      }
    }

    // ─── Contact form ────────────────────────────────────────────────────────
    // Write-only from the app; read in the Firebase console
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'purpose', 'message', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 4000;
    }
  }
}
