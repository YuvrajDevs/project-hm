{
  "name": "honest-mailbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rules": "firebase emulators:exec --only firestore --project demo-honest-mailbox \"node --test tests/firestore.rules.test.mjs\"",
    "test:unit": "node --test tests/dates.test.mjs tests/games.test.mjs tests/profile.test.mjs tests/thoughts.test.mjs tests/strokes.test.mjs tests/seo.test.mjs tests/security.test.mjs",
    "test": "npm run test:unit && npm run test:rules",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-honest-mailbox",
    "dev:emulators": "NEXT_PUBLIC_USE_EMULATORS=1 next dev"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.1",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
